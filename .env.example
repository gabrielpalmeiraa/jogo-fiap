# Copie para .env e preencha. NÃO suba o .env para o GitHub.
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.65
# Chave que protege a API de IA do grupo (header X-API-Key). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_API_KEY=troque_por_uma_chave_longa_e_aleatoria
# Opcional: URL da API de IA se ela rodar em outro serviço (padrão: o próprio servidor)
# IA_API_URL=http://127.0.0.1:8000
# Opcional: origens CORS permitidas, separadas por vírgula
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
